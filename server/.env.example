# ============================================================
# Ryx Island Servidor Node.js 20 LTS — variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# ============================================================

# Puerto del servidor
PORT=3000

# ============================================================
# Credenciales del OWNER para el panel de control
# (ARCHIVO SENSIBLE — nunca subir a git)
# ============================================================
OWNER_USER=admin
OWNER_PASSWORD=CambiarEstaContraseña123!

# ============================================================
# Seguridad
# ============================================================
# Clave para firmar sesiones del panel
SESSION_SECRET=CambiarEstaClaveSecretaMuyLargaYAleatoria

# IPs autorizadas para acceder al panel (vacía = todas permitidas, no recomendado)
# Ejemplo: 203.0.113.5,198.51.100.23
ALLOWED_IPS=

# IP del servidor (para detección de país por IP de usuario)
SERVER_IP=

# ============================================================
# Base de datos
# ============================================================
DB_PATH=./data/ryxisland.db

# ============================================================
# Precios de licencias (en soles PEN)
# ============================================================
LIC_PERMANENTE=4.00
LIC_SEMANAL=0.50
LIC_DIARIO=0.20
LIC_MENSUAL=1.00
